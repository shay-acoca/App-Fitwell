# Copy to .env for local development. Never commit real values.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite locally. Use a PostgreSQL URL in production.
DATABASE_URL=
CORS_ALLOW_ALL_ORIGINS=False

# Optional: real email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional
PEXELS_API_KEY=
